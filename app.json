{
  "expo": {
    "name": "Momentum – Men's Workout",
    "slug": "momentum-men",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samayvashsht.momentummen",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.samayvashsht.momentummen",
      "adaptiveIcon": {
        "backgroundColor": "#0f0f0f"
      }
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f0f0f"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1b924162-652d-4c7b-975f-de90836a4106"
      }
    },
    "owner": "krosz"
  }
}
